# Copy to ~/.config/team-sync-reporter/secrets.env and chmod 600.
# Do not commit or paste real values into chat.

# Feishu custom bot webhook, for send.mode=webhook.
FEISHU_BOT_WEBHOOK=

# Optional Feishu custom bot signing secret.
FEISHU_BOT_SECRET=

# Optional test bot or test group. Use this before enabling production sends.
FEISHU_TEST_BOT_WEBHOOK=
FEISHU_TEST_BOT_SECRET=

# Optional variables used by your Feishu/Wiki export command.
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_TENANT_KEY=
