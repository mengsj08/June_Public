#!/usr/bin/env python3
"""看板卡删除守护 (pre-commit)。

阻止把「删除任务卡 .md」提交进 git——除非该卡已归档到同项目 `.archive/`，
或卡仍以同一 task_id / legacy_id 存在于别处（改名 / 迁移）。

看板自身只能软删到 `.archive/`（见 scan-docs.py `archive_task_card`，无硬删能力）。
本守护堵的是**绕过看板、在文件系统层裸删卡**的路径：手动 `rm`、AI 大扫除、迁移脚本。
git-sync 自动提交不带 --no-verify，故本 hook 同时盖住手动提交与自动同步。

只检测纯删除（--diff-filter=D）；改名（R）天然放行，因为卡内容仍在新文件里。
判活逻辑：被删卡的 task_id 仍出现在某张存活卡的 task_id/legacy_id 里 → 视为迁移，放行。

有意删除（批量迁移 / 确认废弃）请显式放行：
    KANBAN_ALLOW_CARD_DELETE=1 git commit ...
  或跳过全部 hook：       git commit --no-verify
误删找回：                git checkout HEAD -- <卡路径>

设计与背景见仓库 CLAUDE.md「删卡守护」。
"""
import os
import re
import subprocess
import sys

SKIP = {"SKILL.md", "README.md", "CHANGELOG.md", "CONTRIBUTING.md", "LICENSE.md"}


def git(*args):
    return subprocess.run(
        ["git", "-c", "core.quotepath=false", *args],
        capture_output=True, text=True,
    )


def is_card(path):
    """卡 = project/<项目>/<文件>.md，扁平一层，排除 .archive/、点文件与 SKIP 清单。"""
    parts = path.split("/")
    if len(parts) != 3 or parts[0] != "project":
        return False
    proj, base = parts[1], parts[2]
    if proj.startswith("."):
        return False
    if not base.endswith(".md") or base.startswith(".") or base in SKIP:
        return False
    return True


def ids_in_blob(ref):
    out = git("show", ref).stdout
    return set(re.findall(r"(?m)^(?:task_id|legacy_id):\s*(\S+)", out))


def main():
    if os.environ.get("KANBAN_ALLOW_CARD_DELETE") == "1":
        return 0

    deleted = [
        p for p in git("diff", "--cached", "--name-only",
                       "--diff-filter=D").stdout.splitlines()
        if is_card(p)
    ]
    if not deleted:
        return 0

    index = git("ls-files").stdout.splitlines()
    # 同项目 .archive/ 里已存在的归档卡（project/<proj>/.archive/<base>）
    archived = set()
    for p in index:
        parts = p.split("/")
        if len(parts) == 4 and parts[0] == "project" and parts[2] == ".archive":
            archived.add((parts[1], parts[3]))

    live_ids = None  # 惰性计算：仅在确有可疑删除时才扫描全部存活卡
    offenders = []
    for path in deleted:
        _, proj, base = path.split("/")
        if (proj, base) in archived:
            continue  # 已软删到同项目 .archive/
        if live_ids is None:
            live_ids = set()
            for p in index:
                if is_card(p):
                    live_ids |= ids_in_blob(":" + p)
        tid = ids_in_blob("HEAD:" + path)
        if tid & live_ids:
            continue  # 卡以同 task_id/legacy_id 存活于别处（改名 / 迁移）
        offenders.append((path, ",".join(sorted(tid)) or "无 task_id"))

    if not offenders:
        return 0

    w = sys.stderr.write
    w("\n\033[31m✗ 看板卡删除守护：拦下未留痕的删卡\033[0m\n\n")
    for path, tid in offenders:
        w(f"  • {path}  ({tid})\n")
    w(
        "\n这些任务卡被删除，但既没归档到同项目 .archive/，"
        "也找不到同 task_id 的存活卡。\n"
        "看板删卡请走面板（软删到 .archive/），不要在文件系统层裸删。\n\n"
        "若确属有意删除（批量迁移 / 确认废弃），显式放行：\n"
        "  KANBAN_ALLOW_CARD_DELETE=1 git commit ...\n"
        "或跳过全部 hook：  git commit --no-verify\n\n"
        "误删可找回：       git checkout HEAD -- <卡路径>\n\n"
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
