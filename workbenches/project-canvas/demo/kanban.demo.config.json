{
  "paths": {
    "repo_root": ".",
    "workspace_root": ".",
    "data_root": "demo"
  },
  "bind_host": "127.0.0.1",
  "allowed_hosts": [],
  "port": 8890,
  "members": ["Demo Owner"],
  "ai_members": ["Demo Operator", "Demo Reviewer"],
