  "studio_dist_dir": "canvas-studio/dist",
  "demo_mode": true,
  "canvas_ai": {
    "enabled": false
  },
  "chains": [],
  "dynamic_boards": [],
  "integrations": {
    "local_tools": {}
  },
  "network_doctor": {"enabled": false, "script": ""},
  "team_sync": {"enabled": false, "auto_sync": false},
  "git_sync": {"enabled": false},
  "auth": {
    "_comment": "INTENTIONAL RISK: local_bypass is enabled only for the fictional one-click loopback demo. Do not copy this setting to shared or externally reachable deployments.",
    "mode": "token",
    "token_file": ".kanban.auth-token",
    "local_bypass": true,
    "autologin": false,
    "bypass_user": "Demo Owner",
    "session_ttl_seconds": 604800
  }
