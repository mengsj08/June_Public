    "owner": {"actor": "demo_owner", "member": "Demo Owner"},
    "operator": {"actor": "demo_operator", "member": "Demo Operator"},
    "reviewer": {"actor": "demo_reviewer", "member": "Demo Reviewer"}
  },
  "scan_dirs": [
    "demo/projects/literature-review",
    "demo/projects/data-analysis"
  ],
  "real_projects_dir": "demo/.real-projects",
