<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.sih-reference</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/ABSOLUTE/PATH/scientific-information-hub/scripts/run_demo.py</string>
    <string>--output-dir</string>
    <string>/ABSOLUTE/PRIVATE/output</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>15</integer></dict>
  <key>StandardOutPath</key><string>/ABSOLUTE/PRIVATE/stdout.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PRIVATE/stderr.log</string>
</dict>
</plist>
